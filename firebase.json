{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "worker/**",
      "worker.js",
      "wrangler.toml",
      "**/*.zip",
      "update-sw.js",
      "build-app.mjs",
      "build-hocsinh.mjs",
      "add-sri.mjs",
      "firestore.rules",
      "app.jsx",
      "app-*.jsx",
      "package.json",
      "package-lock.json",
      "input.css",
      "tailwind.config.js",
      "tailwind.hocsinh.config.js",
      "hocsinh.js",
      "hocsinh.css"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/@(app.min.js|edu-common.js|hocsinh.min.js|tailwind.min.css|index.css|hocsinh.min.css|hocsinh-tw.min.css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/chunks/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(png|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ],
    "predeploy": [
      "npm run build",
      "node update-sw.js"
    ]
  }
}

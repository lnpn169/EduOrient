{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "update-sw.js",
      "build-app.mjs",
      "build-hocsinh.mjs",
      "firestore.rules",
      "app.jsx",
      "app-*.jsx",
      "package.json",
      "package-lock.json",
      "input.css",
      "tailwind.config.js"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/@(app.min.js|edu-common.js|hocsinh.min.js|tailwind.min.css|index.css|hocsinh.min.css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/chunks/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(png|webmanifest)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      }
    ],
    "predeploy": [
      "npm run build",
      "node update-sw.js"
    ]
  }
}
